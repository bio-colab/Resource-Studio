{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": "resource_studio.tools.v1",
  "protocol": {
    "mcp": "2026-07-28",
    "transports": ["stdio"]
  },
  "capabilities": {
    "tools": {"listChanged": false},
    "resources": {"subscribe": false, "listChanged": false},
    "prompts": {"listChanged": false}
  },
  "tools": {
    "bootstrap": [
      "resource_studio.register_file"
    ],
    "readOnly": [
      "resource_studio.inspect_file",
      "resource_studio.index_resources",
      "resource_studio.diff_files",
      "resource_studio.read_audit"
    ],
    "planning": [
      "resource_studio.create_workspace",
      "resource_studio.plan_resource_change",
      "resource_studio.get_plan"
    ],
    "mutating": [
      "resource_studio.apply_plan",
      "resource_studio.export_workspace",
      "resource_studio.cancel_plan"
    ]
  },
  "resources": {
    "static": ["resource://workspace/info"],
    "templates": [
      "resource://workspace/{workspace_id}",
      "resource://file/{file_id}/manifest",
      "resource://file/{file_id}/resource/{resource_key}",
      "resource://plan/{plan_id}",
      "resource://operation/{operation_id}/audit"
    ]
  },
  "prompts": ["review_change", "pe_triage"],
  "policy": {
    "originalPathsReadOnly": true,
    "mutationsRequirePlan": true,
    "mutationsRequireHumanConfirmation": true,
    "mutationsRequireWorkspace": true,
    "postWriteReopenAndVerify": true,
    "confirmationTtlSeconds": 600,
    "arbitraryCommandTool": false,
    "arbitraryFileWriteTool": false,
    "defaultMaxInputBytes": 268435456,
    "maxResourceRawBytes": 4194304,
    "stateScope": "stdio-session-memory"
  },
  "result": {
    "schema": "resource_studio.result.v1",
    "requiredFields": [
      "operationId",
      "status",
      "source",
      "output",
      "changes",
      "warnings",
      "verification",
      "auditUri"
    ]
  }
}
