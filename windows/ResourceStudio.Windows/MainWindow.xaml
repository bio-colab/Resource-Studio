<Window x:Class="ResourceStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resource Studio — PE Resource Workbench" Icon="Assets/resource-studio.ico" Height="780" Width="1280" MinHeight="600" MinWidth="940" Background="{DynamicResource DeepSlateBrush}" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SlatePanelBrush}" BorderBrush="{DynamicResource SignalCyanBrush}" BorderThickness="0,0,0,1" Padding="6" CornerRadius="6" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,14,0">
                    <Image Source="Assets/resource-studio-icon-32.png" Width="28" Height="28" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="Resource Studio" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="PE Resource Workbench" FontSize="10" Foreground="{DynamicResource MistBrush}" />
                    </StackPanel>
                </StackPanel>
                <ToolBarTray AutomationProperties.Name="Primary actions">

            <ToolBar Header="Workspace">
                <Button AutomationProperties.AutomationId="OpenPeButton" AutomationProperties.AcceleratorKey="Ctrl+O" AutomationProperties.HelpText="Open a PE file without modifying it; shortcut Ctrl+O" ToolTip="Open a PE file without modifying it" Content="Open PE" Click="OpenPe_Click" />
                <Button AutomationProperties.AutomationId="ListResourcesButton" ToolTip="Explore the resources in the current PE" Content="Explore resources" Click="List_Click" />
                <Button AutomationProperties.AutomationId="InspectButton" AutomationProperties.AcceleratorKey="Ctrl+I" AutomationProperties.HelpText="Inspect PE structure and integrity; shortcut Ctrl+I" ToolTip="Inspect PE structure and integrity" Content="Inspect" Click="Inspect_Click" />
                <Button AutomationProperties.AutomationId="ValidateButton" AutomationProperties.HelpText="Validate the current PE without writing" ToolTip="Validate the current PE without writing" Content="Validate" Click="Validate_Click" />
            </ToolBar>
            <ToolBar Header="Editors">
                <Button AutomationProperties.AutomationId="DialogEditorButton" ToolTip="Edit a dialog visually and save a new PE" Content="Dialog Editor" Click="DialogEditor_Click" />
                <Button AutomationProperties.AutomationId="StringTableEditorButton" ToolTip="Edit StringTable entries and save a new PE" Content="StringTable Editor" Click="StringTableEditor_Click" />
                <Button AutomationProperties.AutomationId="ResourceWizardsButton" ToolTip="Edit VersionInfo, Manifest, or Menu" Content="Resource Wizards" Click="ResourceWizards_Click" />
                <Button AutomationProperties.AutomationId="ImageWizardButton" ToolTip="Preview and edit bitmap, icon, or cursor resources" Content="Image Wizard" Click="ImageWizard_Click" />
            </ToolBar>
            <ToolBar Header="Tools">
                <Button AutomationProperties.AutomationId="AuthenticodeToolsButton" ToolTip="Inspect or change signature state using Save As" Content="Authenticode Tools" Click="AuthenticodeTools_Click" />
                <Button AutomationProperties.AutomationId="PythonGuiButton" ToolTip="Open the legacy Python interface" Content="Open Python GUI" Click="OpenPythonGui_Click" />
                <Button AutomationProperties.AutomationId="ThemeButton" ToolTip="Toggle light and dark appearance" Content="Toggle dark mode" Click="Theme_Click" />
            </ToolBar>
                </ToolBarTray>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="1" Margin="4,0,4,8" AutomationProperties.Name="Workspace context">
            <TextBlock Text="Current PE" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox AutomationProperties.AutomationId="PathBox" AutomationProperties.Name="Current PE path" x:Name="PathBox" Padding="6" IsReadOnly="True" ToolTip="The input PE is never overwritten; edits use Save As" />
            <TextBlock AutomationProperties.AutomationId="OutputPolicyText" Text="Save As only" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="The original input remains unchanged" />
        </DockPanel>
        <TabControl Grid.Row="2" Margin="4,0,4,4" AutomationProperties.Name="Resource Studio workbench">
            <TabItem AutomationProperties.AutomationId="ResourcesTab" Header="Resources">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,6">
                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="ResourceFilterBox" Width="260" TextChanged="ResourceFilterBox_TextChanged" />
                        <TextBlock AutomationProperties.AutomationId="ResourceCountText" x:Name="ResourceCountText" Text="0 resources" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </DockPanel>
                    <DataGrid AutomationProperties.AutomationId="ResourceGrid" AutomationProperties.Name="Resource list" x:Name="ResourceGrid" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="ResourceGrid_SelectionChanged" LoadingRow="ResourceGrid_LoadingRow" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Properties" FontWeight="Bold" Margin="0,0,0,6" />
                        <DataGrid AutomationProperties.AutomationId="PropertyGrid" AutomationProperties.Name="Selected resource properties" x:Name="PropertyGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="PreviewTab" Header="Preview">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewHeader" Text="Select a resource to preview." Margin="0,0,0,6" />
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><ScrollViewer AutomationProperties.Name="Visual preview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="PreviewVisualPanel" Margin="4" /></ScrollViewer><Grid Grid.Column="1" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="170" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Structural template fields — select a field to highlight its bytes" FontWeight="SemiBold" Margin="0,0,0,4" /><DataGrid x:Name="PreviewFieldsGrid" AutomationProperties.AutomationId="PreviewFieldsGrid" AutomationProperties.Name="Hex template fields" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="PreviewFieldsGrid_SelectionChanged" Grid.Row="1" /><TextBlock Text="Hex bytes" FontWeight="SemiBold" Margin="0,8,0,4" Grid.Row="2" /><TextBox AutomationProperties.AutomationId="PreviewHexBox" AutomationProperties.Name="Raw hex bytes" x:Name="PreviewHexBox" Grid.Row="3" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></Grid></Grid>
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="SearchTab" Header="Search">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBox AutomationProperties.AutomationId="SearchQueryBox" x:Name="SearchQueryBox" Width="300" Margin="0,0,6,0" />
                        <CheckBox x:Name="SearchRegexBox" Content="Regex" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox x:Name="SearchHexBox" Content="Hex" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button AutomationProperties.AutomationId="SearchButton" Content="Search" Click="Search_Click" />
                    </WrapPanel>
                    <DataGrid AutomationProperties.AutomationId="SearchResultsGrid" AutomationProperties.Name="Search results" x:Name="SearchGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" />
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="BatchTab" Header="Batch Workspace">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Browse manifest" DockPanel.Dock="Right" Click="BatchBrowse_Click" />
                        <TextBox x:Name="BatchManifestBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="Plan (dry-run)" Click="BatchPlan_Click" Margin="0,0,6,0" />
                        <Button Content="Apply batch" Click="BatchApply_Click" />
                    </WrapPanel>
                    <TextBox AutomationProperties.AutomationId="BatchReportBox" AutomationProperties.Name="Batch report" x:Name="BatchReportBox" Grid.Row="2" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="LocalizationTab" Header="Localization">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Browse catalog" DockPanel.Dock="Right" Click="LocalizationBrowse_Click" />
                        <TextBox x:Name="LocalizationCatalogBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="LocalizationSourceBox" Width="90" Text="en" Margin="0,0,8,0" />
                        <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="LocalizationTargetBox" Width="90" Text="ar" Margin="0,0,8,0" />
                        <Button Content="Compare" Click="LocalizationCompare_Click" Margin="0,0,6,0" />
                        <Button Content="Pseudo-localize" Click="LocalizationPseudo_Click" />
                    </WrapPanel>
                    <TextBox AutomationProperties.AutomationId="LocalizationOutputBox" AutomationProperties.Name="Localization output" x:Name="LocalizationOutputBox" Grid.Row="2" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="InspectTab" Header="Inspect">
                <TextBox AutomationProperties.AutomationId="InspectDetailsBox" AutomationProperties.Name="Inspection details" x:Name="InspectBox" Margin="6" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem AutomationProperties.AutomationId="SecurityTab" Header="Security Center">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,6">
                        <Button AutomationProperties.AutomationId="SecurityAnalyzeButton" Content="Analyze PE" Click="SecurityAnalyze_Click" Margin="0,0,6,0" ToolTip="Run static-only analysis; the PE is never executed" />
                        <Button AutomationProperties.AutomationId="EvidenceGraphButton" Content="Build Evidence Graph" Click="EvidenceGraph_Click" Margin="0,0,6,0" ToolTip="Build a deterministic graph from normalized evidence" />
                        <Button AutomationProperties.AutomationId="CaseCreateButton" Content="Create Case" Click="CaseCreate_Click" Margin="0,0,6,0" ToolTip="Create a case JSON without modifying the PE" />
                        <Button AutomationProperties.AutomationId="CaseAnalyzeButton" Content="Analyze Case" Click="CaseAnalyze_Click" />
                    </WrapPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button AutomationProperties.AutomationId="EvidenceQueryButton" Content="Run Query" DockPanel.Dock="Right" Click="EvidenceQuery_Click" />
                        <TextBox AutomationProperties.AutomationId="EvidenceQueryBox" AutomationProperties.Name="Evidence query" x:Name="EvidenceQueryBox" Text="finding.severity == &quot;HIGH&quot;" Margin="0,0,6,0" ToolTip="Safe query: resource.type == &quot;ICON&quot; or evidence.confidence &gt;= 0.8" />
                    </DockPanel>
                    <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBox AutomationProperties.AutomationId="AnnotationTargetKindBox" AutomationProperties.Name="Annotation target kind" x:Name="AnnotationTargetKindBox" Width="90" Text="resource" Margin="0,0,6,0" ToolTip="Target kind, for example resource or finding" />
                        <TextBox AutomationProperties.AutomationId="AnnotationTargetIdBox" AutomationProperties.Name="Annotation target id" x:Name="AnnotationTargetIdBox" Width="150" Margin="0,0,6,0" ToolTip="Stable target identifier" />
                        <TextBox AutomationProperties.AutomationId="AnnotationTagBox" AutomationProperties.Name="Annotation tag" x:Name="AnnotationTagBox" Width="110" Margin="0,0,6,0" ToolTip="Optional tag" />
                        <TextBox AutomationProperties.AutomationId="AnnotationNoteBox" AutomationProperties.Name="Annotation note" x:Name="AnnotationNoteBox" Width="220" Margin="0,0,6,0" ToolTip="Optional note" />
                        <Button AutomationProperties.AutomationId="AddAnnotationButton" Content="Add Annotation" Click="AddAnnotation_Click" Margin="0,0,6,0" />
                        <Button AutomationProperties.AutomationId="ExportSelectionButton" Content="Export Selection" Click="ExportSelection_Click" Margin="0,0,6,0" />
                        <Border x:Name="TriageBanner" Padding="8,3" Background="#E5E7EB" BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="3" AutomationProperties.Name="Evidence triage status">
                            <TextBlock x:Name="TriageBannerText" Text="Triage: not run" FontWeight="SemiBold" />
                        </Border>
                    </WrapPanel>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBox AutomationProperties.AutomationId="SecurityReportBox" AutomationProperties.Name="Static security report" x:Name="SecurityReportBox" Grid.Row="0" Grid.Column="0" Margin="0,0,6,6" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                        <TextBox AutomationProperties.AutomationId="EvidenceGraphBox" AutomationProperties.Name="Evidence graph" x:Name="EvidenceGraphBox" Grid.Row="0" Grid.Column="1" Margin="6,0,0,6" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                        <TextBox AutomationProperties.AutomationId="EvidenceQueryResultsBox" AutomationProperties.Name="Evidence query results" x:Name="EvidenceQueryResultsBox" Grid.Row="1" Grid.Column="0" Margin="0,6,6,0" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                        <TextBox AutomationProperties.AutomationId="CasePathBox" AutomationProperties.Name="Case file path" x:Name="CasePathBox" Grid.Row="1" Grid.Column="1" Margin="6,6,0,0" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="DiffTab" Header="Diff">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Browse" DockPanel.Dock="Right" Click="DiffLeftBrowse_Click" />
                        <TextBox x:Name="DiffLeftBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="Browse" DockPanel.Dock="Right" Click="DiffRightBrowse_Click" />
                        <TextBox x:Name="DiffRightBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Button Content="Compare resources" HorizontalAlignment="Left" Click="CompareDiff_Click" />
                        <TreeView x:Name="DiffTree" Grid.Row="1" Margin="0,6,0,0" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Margin="4" Padding="8,5" BorderBrush="#D0D7DE" BorderThickness="1" AutomationProperties.Name="Operation status">
            <StackPanel Orientation="Horizontal">
                <TextBlock AutomationProperties.AutomationId="MainStatusText" x:Name="StatusText" Text="Ready" Margin="0,0,12,0" />
                <TextBlock AutomationProperties.AutomationId="CliStateText" x:Name="CliStateText" Text="Idle" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBlock AutomationProperties.AutomationId="StatusDetailText" x:Name="StatusDetailText" Text="Open a PE to begin" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <Button AutomationProperties.AutomationId="StopCliButton" AutomationProperties.HelpText="Stop the active CLI process; the input remains unchanged" x:Name="StopCliButton" Content="Stop" Click="StopCli_Click" IsEnabled="False" Padding="10,2" ToolTip="Stop the current CLI operation; the input remains unchanged" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
