<Window x:Class="ResourceStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resource Studio — PE Resource Workbench" Icon="Assets/resource-studio.ico" Height="780" Width="1280" MinHeight="600" MinWidth="940" Background="{DynamicResource DeepSlateBrush}" PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SlatePanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="6,4" CornerRadius="6" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <!-- Theme Button: Pinned to the Right -->
                <Button AutomationProperties.AutomationId="ThemeButton" 
                        AutomationProperties.Name="Toggle dark mode" 
                        DockPanel.Dock="Right" 
                        VerticalAlignment="Center"
                        Margin="6,0,0,0"
                        ToolTip="Toggle light and dark appearance" 
                        Click="Theme_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◐" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="Theme" />
                    </StackPanel>
                </Button>

                <!-- Brand / Logo / About: Docked to the Left -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,10,0">
                    <Image Source="Assets/resource-studio-icon-32.png" Width="28" Height="28" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Resource Studio" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="PE Resource Workbench" FontSize="10" Foreground="{DynamicResource MistBrush}" />
                    </StackPanel>
                    <Button AutomationProperties.AutomationId="AboutButton" 
                            AutomationProperties.Name="About Resource Studio" 
                            ToolTip="About Resource Studio and its developer" 
                            Margin="8,0,0,0"
                            Click="About_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="About" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Command Actions: Modern Responsive Toolbar -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
                    <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <!-- Workspace Group -->
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="5" Padding="3,2" Margin="3,2" Background="{DynamicResource SlateInputBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MistBrush}" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button AutomationProperties.AutomationId="OpenPeButton" Style="{DynamicResource PrimaryButton}" AutomationProperties.AcceleratorKey="Ctrl+O" AutomationProperties.HelpText="Open a PE file without modifying it; shortcut Ctrl+O" AutomationProperties.Name="Open PE" ToolTip="Open a PE file without modifying it" Click="OpenPe_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↥" FontSize="14" Margin="0,0,4,0" /><TextBlock Text="Open PE" /></StackPanel></Button>
                                <Button AutomationProperties.AutomationId="RecentFilesButton" ToolTip="Recent PE files" Click="RecentFiles_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="13" Margin="0,0,4,0" /><TextBlock Text="Recent" /></StackPanel><Button.ContextMenu><ContextMenu x:Name="RecentFilesMenu" /></Button.ContextMenu></Button>
                                <Button AutomationProperties.AutomationId="ListResourcesButton" AutomationProperties.Name="Explore resources" ToolTip="Explore the resources in the current PE" Click="List_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="☷" FontSize="14" Margin="0,0,4,0" /><TextBlock Text="Explore" /></StackPanel></Button>
                                <Button AutomationProperties.AutomationId="InspectButton" AutomationProperties.AcceleratorKey="Ctrl+I" AutomationProperties.HelpText="Inspect PE structure and integrity; shortcut Ctrl+I" AutomationProperties.Name="Inspect" ToolTip="Inspect PE structure and integrity" Click="Inspect_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="14" Margin="0,0,4,0" /><TextBlock Text="Inspect" /></StackPanel></Button>
                                <Button AutomationProperties.AutomationId="ValidateButton" AutomationProperties.Name="Validate" AutomationProperties.HelpText="Validate the current PE without writing" ToolTip="Validate the current PE without writing" Click="Validate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="13" Margin="0,0,4,0" /><TextBlock Text="Validate" /></StackPanel></Button>
                            </StackPanel>
                        </Border>

                        <!-- Editors Group -->
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="5" Padding="3,2" Margin="3,2" Background="{DynamicResource SlateInputBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="EDITORS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MistBrush}" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button AutomationProperties.AutomationId="DialogEditorButton" AutomationProperties.Name="Dialog Editor" ToolTip="Edit a dialog visually and save a new PE" Click="DialogEditor_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▱" FontSize="14" Margin="0,0,4,0" /><TextBlock Text="Dialog" /></StackPanel></Button>
                                <Button AutomationProperties.AutomationId="StringTableEditorButton" AutomationProperties.Name="StringTable Editor" ToolTip="Edit StringTable entries and save a new PE" Click="StringTableEditor_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="A" FontSize="13" Margin="0,0,4,0" /><TextBlock Text="StringTable" /></StackPanel></Button>
                                <Button AutomationProperties.AutomationId="ResourceWizardsButton" AutomationProperties.Name="Resource Wizards" ToolTip="Edit VersionInfo, Manifest, or Menu" Click="ResourceWizards_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="✦" FontSize="13" Margin="0,0,4,0" /><TextBlock Text="Wizards" /></StackPanel></Button>
                                <Button AutomationProperties.AutomationId="ImageWizardButton" AutomationProperties.Name="Image Wizard" ToolTip="Preview and edit bitmap, icon, or cursor resources" Click="ImageWizard_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" FontSize="14" Margin="0,0,4,0" /><TextBlock Text="Images" /></StackPanel></Button>
                            </StackPanel>
                        </Border>

                        <!-- Tools Group -->
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="5" Padding="3,2" Margin="3,2" Background="{DynamicResource SlateInputBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="TOOLS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MistBrush}" VerticalAlignment="Center" Margin="4,0,4,0" />
                                <Button AutomationProperties.AutomationId="AuthenticodeToolsButton" AutomationProperties.Name="Authenticode Tools" ToolTip="Inspect or change signature state using Save As" Click="AuthenticodeTools_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="13" Margin="0,0,4,0" /><TextBlock Text="Signatures" /></StackPanel></Button>
                                <Button AutomationProperties.AutomationId="PythonGuiButton" AutomationProperties.Name="Open Python GUI" ToolTip="Open the legacy Python interface" Click="OpenPythonGui_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="›_" FontSize="12" Margin="0,0,4,0" /><TextBlock Text="Python GUI" /></StackPanel></Button>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <StackPanel Grid.Row="1" Margin="4,0,4,8" AutomationProperties.Name="Workspace context">
            <DockPanel>
                <TextBlock Text="Current PE" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox AutomationProperties.AutomationId="PathBox" AutomationProperties.Name="Current PE path" x:Name="PathBox" Padding="6" IsReadOnly="True" ToolTip="The input PE is never overwritten; edits use Save As" />
                <TextBlock AutomationProperties.AutomationId="OutputPolicyText" Text="Save As only" Foreground="{DynamicResource MistBrush}" VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="The original input remains unchanged" />
            </DockPanel>
            <WrapPanel x:Name="IdentityPanel" Margin="0,6,0,2" Visibility="Collapsed" AutomationProperties.Name="PE Identity Card" />
            <Border x:Name="NoticeBanner" Margin="0,4,0,2" Padding="8,4" CornerRadius="4" Background="#261E10" BorderBrush="{DynamicResource TriageAmberBrush}" BorderThickness="1" Visibility="Collapsed">
                <StackPanel x:Name="NoticePanel" Orientation="Vertical" />
            </Border>
        </StackPanel>
        <TabControl Grid.Row="2" Margin="4,0,4,4" AutomationProperties.Name="Resource Studio workbench" Background="{DynamicResource DeepSlateBrush}">
            <TabItem AutomationProperties.AutomationId="ResourcesTab" Header="Resources">
                <Grid Margin="6" Background="{DynamicResource SlatePanelBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,6">
                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="ResourceFilterBox" Width="260" TextChanged="ResourceFilterBox_TextChanged" />
                        <TextBlock AutomationProperties.AutomationId="ResourceCountText" x:Name="ResourceCountText" Text="0 resources" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource MistBrush}" />
                    </DockPanel>
                    <Grid Grid.Row="1" Grid.Column="0">
                        <DataGrid AutomationProperties.AutomationId="ResourceGrid" AutomationProperties.Name="Resource list" x:Name="ResourceGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="ResourceGrid_SelectionChanged" LoadingRow="ResourceGrid_LoadingRow" MouseDoubleClick="ResourceGrid_MouseDoubleClick" PreviewKeyDown="ResourceGrid_PreviewKeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit Resource..." Click="EditSelectedResource_Click" FontWeight="SemiBold" />
                                    <Separator />
                                    <MenuItem Header="Copy as C/C++ Byte Array" Click="CopyAsCArray_Click" />
                                    <MenuItem Header="Copy as C# ReadOnlySpan&lt;byte&gt;" Click="CopyAsCSharpSpan_Click" />
                                    <MenuItem Header="Copy as Base64 String" Click="CopyAsBase64_Click" />
                                    <MenuItem Header="Copy SHA-256 Hash" Click="CopySha256_Click" />
                                    <Separator />
                                    <MenuItem Header="Generate Win32 'resource.h'..." Click="GenerateResourceHeader_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                        <StackPanel x:Name="ResourceEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⌁" FontSize="34" Foreground="{DynamicResource SignalCyanBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock x:Name="ResourceEmptyStateText" Text="Open a PE to explore its resources" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Drag and drop any PE file here, or click below" Foreground="{DynamicResource MistBrush}" HorizontalAlignment="Center" Margin="0,4,0,10" />
                            <Button Content="Open PE File..." Padding="14,5" HorizontalAlignment="Center" Click="OpenPe_Click" Style="{DynamicResource PrimaryButton}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Properties" FontWeight="Bold" Margin="0,0,0,6" />
                        <Grid Grid.Row="1">
                            <DataGrid AutomationProperties.AutomationId="PropertyGrid" AutomationProperties.Name="Selected resource properties" x:Name="PropertyGrid" AutoGenerateColumns="True" IsReadOnly="True" />
                            <StackPanel x:Name="PropertyEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="Select a resource" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Properties and typed preview appear here" Foreground="{DynamicResource MistBrush}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="PreviewTab" Header="Preview">
                <Grid Margin="6" Background="{DynamicResource SlatePanelBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewHeader" Text="Select a resource to preview." Margin="0,0,0,6" />
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><ScrollViewer AutomationProperties.Name="Visual preview" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="PreviewVisualPanel" Margin="4" /></ScrollViewer><Grid Grid.Column="1" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="170" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Structural template fields — select a field to highlight its bytes" FontWeight="SemiBold" Margin="0,0,0,4" /><DataGrid x:Name="PreviewFieldsGrid" AutomationProperties.AutomationId="PreviewFieldsGrid" AutomationProperties.Name="Hex template fields" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="PreviewFieldsGrid_SelectionChanged" Grid.Row="1" /><TextBlock Text="Hex bytes" FontWeight="SemiBold" Margin="0,8,0,4" Grid.Row="2" /><TextBox AutomationProperties.AutomationId="PreviewHexBox" AutomationProperties.Name="Raw hex bytes" x:Name="PreviewHexBox" Grid.Row="3" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></Grid></Grid>
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="SearchTab" Header="Search">
                <Grid Margin="6" Background="{DynamicResource SlatePanelBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBox AutomationProperties.AutomationId="SearchQueryBox" x:Name="SearchQueryBox" Width="300" Margin="0,0,6,0" />
                        <CheckBox x:Name="SearchRegexBox" Content="Regex" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox x:Name="SearchHexBox" Content="Hex" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button AutomationProperties.AutomationId="SearchButton" Content="Search" Click="Search_Click" />
                    </WrapPanel>
                    <DataGrid AutomationProperties.AutomationId="SearchResultsGrid" AutomationProperties.Name="Search results" x:Name="SearchGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" />
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="BatchTab" Header="Batch Workspace">
                <Grid Margin="6" Background="{DynamicResource SlatePanelBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Browse manifest" DockPanel.Dock="Right" Click="BatchBrowse_Click" />
                        <TextBox x:Name="BatchManifestBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="Plan (dry-run)" Click="BatchPlan_Click" Margin="0,0,6,0" />
                        <Button Content="Apply batch" Click="BatchApply_Click" />
                    </WrapPanel>
                    <TextBox AutomationProperties.AutomationId="BatchReportBox" AutomationProperties.Name="Batch report" x:Name="BatchReportBox" Grid.Row="2" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="LocalizationTab" Header="Localization">
                <Grid Margin="6" Background="{DynamicResource SlatePanelBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Browse catalog" DockPanel.Dock="Right" Click="LocalizationBrowse_Click" />
                        <TextBox x:Name="LocalizationCatalogBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="LocalizationSourceBox" Width="90" Text="en" Margin="0,0,8,0" />
                        <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="LocalizationTargetBox" Width="90" Text="ar" Margin="0,0,8,0" />
                        <Button Content="Compare" Click="LocalizationCompare_Click" Margin="0,0,6,0" />
                        <Button Content="Pseudo-localize" Click="LocalizationPseudo_Click" />
                    </WrapPanel>
                    <TextBox AutomationProperties.AutomationId="LocalizationOutputBox" AutomationProperties.Name="Localization output" x:Name="LocalizationOutputBox" Grid.Row="2" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem AutomationProperties.AutomationId="InspectTab" Header="Inspect">
                <TextBox AutomationProperties.AutomationId="InspectDetailsBox" AutomationProperties.Name="Inspection details" x:Name="InspectBox" Margin="6" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem AutomationProperties.AutomationId="DiffTab" Header="Diff">
                <Grid Margin="6" Background="{DynamicResource SlatePanelBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Browse" DockPanel.Dock="Right" Click="DiffLeftBrowse_Click" />
                        <TextBox x:Name="DiffLeftBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="Browse" DockPanel.Dock="Right" Click="DiffRightBrowse_Click" />
                        <TextBox x:Name="DiffRightBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="Compare resources" Click="CompareDiff_Click" Margin="0,0,8,0" Style="{DynamicResource PrimaryButton}" />
                            <CheckBox x:Name="DiffTypedCheck" Content="Typed diff (inspect properties)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="Export Automation Recipe..." Click="ExportRecipe_Click" />
                        </WrapPanel>
                        <TreeView x:Name="DiffTree" Grid.Row="1" Margin="0,6,0,0" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <ProgressBar x:Name="OperationProgressBar" Grid.Row="2" VerticalAlignment="Bottom" Height="2" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource SignalCyanBrush}" Background="Transparent" BorderThickness="0" Margin="4,0,4,0" />
        <Border Grid.Row="3" Margin="4" Padding="8,5" Background="{DynamicResource SlatePanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" AutomationProperties.Name="Operation status">
            <DockPanel>
                <Button AutomationProperties.AutomationId="StopCliButton" AutomationProperties.HelpText="Stop the active CLI process; the input remains unchanged" x:Name="StopCliButton" DockPanel.Dock="Right" Background="{DynamicResource EvidenceRedBrush}" Foreground="{DynamicResource DeepSlateBrush}" BorderBrush="{DynamicResource EvidenceRedBrush}" Click="StopCli_Click" IsEnabled="False" Padding="10,2" ToolTip="Stop the current CLI operation; the input remains unchanged"><StackPanel Orientation="Horizontal"><TextBlock Text="■" FontSize="11" Margin="0,0,5,0" /><TextBlock Text="Stop" /></StackPanel></Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock AutomationProperties.AutomationId="MainStatusText" x:Name="StatusText" Text="Ready" Margin="0,0,12,0" />
                    <TextBlock AutomationProperties.AutomationId="CliStateText" x:Name="CliStateText" Text="Idle" Foreground="{DynamicResource SignalCyanBrush}" FontWeight="SemiBold" Margin="0,0,12,0" />
                    <TextBlock AutomationProperties.AutomationId="StatusDetailText" x:Name="StatusDetailText" Text="Open a PE to begin" Foreground="{DynamicResource MistBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
