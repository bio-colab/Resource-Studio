<Window x:Class="ResourceStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resource Studio" Height="720" Width="1180" MinHeight="520" MinWidth="820">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Button Content="Open PE" Click="OpenPe_Click" />
            <Button Content="List resources" Click="List_Click" />
            <Button Content="Inspect" Click="Inspect_Click" />
            <Button Content="Validate" Click="Validate_Click" />
            <Button Content="Open Python GUI" Click="OpenPythonGui_Click" />
        </StackPanel>
        <TextBox x:Name="PathBox" Grid.Row="1" Margin="4" Padding="6" IsReadOnly="True" />
        <Grid Grid.Row="2" Margin="4,8,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ResourceGrid" Grid.Column="0" AutoGenerateColumns="True" IsReadOnly="True" />
            <TextBox x:Name="OutputBox" Grid.Column="1" Margin="8,0,0,0" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" IsReadOnly="True" />
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="4" Text="Ready" />
    </Grid>
</Window>
