<Window x:Class="ResourceStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resource Studio" Height="780" Width="1280" MinHeight="600" MinWidth="940" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel>
            <Button Content="Open PE" Click="OpenPe_Click" Margin="0,0,6,6" />
            <Button Content="List resources" Click="List_Click" Margin="0,0,6,6" />
            <Button Content="Inspect" Click="Inspect_Click" Margin="0,0,6,6" />
            <Button Content="Validate" Click="Validate_Click" Margin="0,0,6,6" />
            <Button Content="Open Python GUI" Click="OpenPythonGui_Click" Margin="0,0,6,6" />
            <Button Content="Dialog Editor" Click="DialogEditor_Click" Margin="0,0,6,6" />
            <Button Content="StringTable Editor" Click="StringTableEditor_Click" Margin="0,0,6,6" />
            <Button Content="Resource Wizards" Click="ResourceWizards_Click" Margin="0,0,6,6" />
            <Button Content="Image Wizard" Click="ImageWizard_Click" Margin="0,0,6,6" />
            <Button Content="Authenticode Tools" Click="AuthenticodeTools_Click" Margin="0,0,6,6" />
            <Button Content="Toggle dark mode" Click="Theme_Click" Margin="0,0,6,6" />
        </WrapPanel>
        <TextBox x:Name="PathBox" Grid.Row="1" Margin="4,0,4,8" Padding="6" IsReadOnly="True" />
        <TabControl Grid.Row="2" Margin="4,0,4,4">
            <TabItem Header="Resources">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,6">
                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="ResourceFilterBox" Width="260" TextChanged="ResourceFilterBox_TextChanged" />
                        <TextBlock x:Name="ResourceCountText" Text="0 resources" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="DarkSlateGray" />
                    </DockPanel>
                    <DataGrid x:Name="ResourceGrid" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="ResourceGrid_SelectionChanged" />
                    <Grid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Properties" FontWeight="Bold" Margin="0,0,0,6" />
                        <DataGrid x:Name="PropertyGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Preview">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewHeader" Text="Select a resource to preview raw bytes." Margin="0,0,0,6" />
                    <TextBox x:Name="PreviewBox" Grid.Row="1" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem Header="Search">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBox x:Name="SearchQueryBox" Width="300" Margin="0,0,6,0" />
                        <CheckBox x:Name="SearchRegexBox" Content="Regex" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <CheckBox x:Name="SearchHexBox" Content="Hex" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Search" Click="Search_Click" />
                    </WrapPanel>
                    <DataGrid x:Name="SearchGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" />
                </Grid>
            </TabItem>
            <TabItem Header="Batch Workspace">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Browse manifest" DockPanel.Dock="Right" Click="BatchBrowse_Click" />
                        <TextBox x:Name="BatchManifestBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="Plan (dry-run)" Click="BatchPlan_Click" Margin="0,0,6,0" />
                        <Button Content="Apply batch" Click="BatchApply_Click" />
                    </WrapPanel>
                    <TextBox x:Name="BatchReportBox" Grid.Row="2" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem Header="Localization">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Browse catalog" DockPanel.Dock="Right" Click="LocalizationBrowse_Click" />
                        <TextBox x:Name="LocalizationCatalogBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="LocalizationSourceBox" Width="90" Text="en" Margin="0,0,8,0" />
                        <TextBlock Text="Target" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBox x:Name="LocalizationTargetBox" Width="90" Text="ar" Margin="0,0,8,0" />
                        <Button Content="Compare" Click="LocalizationCompare_Click" Margin="0,0,6,0" />
                        <Button Content="Pseudo-localize" Click="LocalizationPseudo_Click" />
                    </WrapPanel>
                    <TextBox x:Name="LocalizationOutputBox" Grid.Row="2" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>
            <TabItem Header="Inspect">
                <TextBox x:Name="InspectBox" Margin="6" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="Diff">
                <Grid Margin="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button Content="Browse" DockPanel.Dock="Right" Click="DiffLeftBrowse_Click" />
                        <TextBox x:Name="DiffLeftBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Content="Browse" DockPanel.Dock="Right" Click="DiffRightBrowse_Click" />
                        <TextBox x:Name="DiffRightBox" Margin="0,0,6,0" />
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Button Content="Compare resources" HorizontalAlignment="Left" Click="CompareDiff_Click" />
                        <TreeView x:Name="DiffTree" Grid.Row="1" Margin="0,6,0,0" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="4" Text="Ready" />
    </Grid>
</Window>
