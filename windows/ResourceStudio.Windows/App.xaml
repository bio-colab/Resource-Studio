<Application x:Class="ResourceStudio.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="DeepSlateColor">#101827</Color>
        <Color x:Key="SlatePanelColor">#182337</Color>
        <Color x:Key="SlateElevatedColor">#223149</Color>
        <Color x:Key="SlateInputColor">#111C2D</Color>
        <Color x:Key="DividerColor">#34445C</Color>
        <Color x:Key="PaperColor">#F3F7FB</Color>
        <Color x:Key="MistColor">#B7C4D6</Color>
        <Color x:Key="SignalCyanColor">#2DD4BF</Color>
        <Color x:Key="AnalysisBlueColor">#60A5FA</Color>
        <Color x:Key="TriageAmberColor">#F59E0B</Color>
        <Color x:Key="EvidenceRedColor">#EF4444</Color>
        <Color x:Key="VerifiedGreenColor">#34D399</Color>

        <SolidColorBrush x:Key="DeepSlateBrush" Color="{StaticResource DeepSlateColor}" />
        <SolidColorBrush x:Key="SlatePanelBrush" Color="{StaticResource SlatePanelColor}" />
        <SolidColorBrush x:Key="SlateElevatedBrush" Color="{StaticResource SlateElevatedColor}" />
        <SolidColorBrush x:Key="SlateInputBrush" Color="{StaticResource SlateInputColor}" />
        <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
        <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
        <SolidColorBrush x:Key="MistBrush" Color="{StaticResource MistColor}" />
        <SolidColorBrush x:Key="SignalCyanBrush" Color="{StaticResource SignalCyanColor}" />
        <SolidColorBrush x:Key="AnalysisBlueBrush" Color="{StaticResource AnalysisBlueColor}" />
        <SolidColorBrush x:Key="TriageAmberBrush" Color="{StaticResource TriageAmberColor}" />
        <SolidColorBrush x:Key="EvidenceRedBrush" Color="{StaticResource EvidenceRedColor}" />
        <SolidColorBrush x:Key="VerifiedGreenBrush" Color="{StaticResource VerifiedGreenColor}" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource DeepSlateBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="Background" Value="{StaticResource SlateElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SignalCyanBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ToolBarTray">
            <Setter Property="Background" Value="{StaticResource SlatePanelBrush}" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style TargetType="ToolBar">
            <Setter Property="Background" Value="{StaticResource SlatePanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SlateInputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource DeepSlateBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MistBrush}" />
            <Setter Property="Background" Value="{StaticResource SlatePanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"
                                              FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource DeepSlateBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource SignalCyanBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SignalCyanBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SlateElevatedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SlatePanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="CanUserAddRows" Value="False" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SlateElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource SlatePanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{StaticResource SlatePanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Application.Resources>
</Application>
