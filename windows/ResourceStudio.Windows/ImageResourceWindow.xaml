<Window x:Class="ResourceStudio.Windows.ImageResourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Wizard" Height="700" Width="980" MinHeight="520" MinWidth="760" Background="{DynamicResource DeepSlateBrush}" Foreground="{DynamicResource PaperBrush}">
    <Grid Margin="12" Background="{DynamicResource DeepSlateBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,8"><TextBlock Text="PE" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox AutomationProperties.AutomationId="ImagePePathBox" x:Name="PePathBox" Width="430" Margin="0,0,8,0" /><TextBlock Text="Kind" VerticalAlignment="Center" Margin="0,0,6,0" /><ComboBox AutomationProperties.AutomationId="ImageKindBox" x:Name="KindBox" Width="100" SelectedIndex="0"><ComboBoxItem Content="bitmap" /><ComboBoxItem Content="icon" /><ComboBoxItem Content="cursor" /></ComboBox></WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock Text="ID" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox AutomationProperties.AutomationId="ImageNameBox" x:Name="NameBox" Width="65" Text="1" Margin="0,0,8,0" /><TextBlock Text="Language" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox AutomationProperties.AutomationId="ImageLanguageBox" x:Name="LanguageBox" Width="75" Text="1033" Margin="0,0,8,0" /><Button AutomationProperties.AutomationId="ImageLoadButton" Content="Load from PE" Click="Load_Click" Margin="0,0,6,0" /><Button Content="Choose payload" Click="ChoosePayload_Click" Margin="0,0,6,0" /><Button AutomationProperties.AutomationId="ImageExportBmpButton" Content="Export selected BMP" Click="ExportPayload_Click" Margin="0,0,6,0" /><Button AutomationProperties.AutomationId="ImageApplyBmpButton" Content="Apply selected BMP/PNG" Click="ApplyPayload_Click" /></WrapPanel>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions><Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0"><Image AutomationProperties.AutomationId="ImagePreview" x:Name="ImagePreview" Stretch="Uniform" /></Border><Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="3*" /></Grid.RowDefinitions><ListBox AutomationProperties.AutomationId="GroupEntriesList" x:Name="GroupEntriesList" DisplayMemberPath="Label" SelectionChanged="GroupEntriesList_SelectionChanged" /><WrapPanel Grid.Row="1" Margin="0,6,0,6"><TextBlock Text="W" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBox x:Name="EntryWidthBox" Width="48" Margin="0,0,6,0" /><TextBlock Text="H" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBox x:Name="EntryHeightBox" Width="48" Margin="0,0,6,0" /><TextBlock Text="ID" VerticalAlignment="Center" Margin="0,0,4,0" /><TextBox x:Name="EntryIdBox" Width="54" Margin="0,0,6,0" /><Button Content="Update" Click="UpdateEntry_Click" Margin="0,0,4,0" /><Button Content="Add" Click="AddEntry_Click" Margin="0,0,4,0" /><Button Content="Remove" Click="RemoveEntry_Click" /></WrapPanel><TextBox x:Name="ModelBox" Grid.Row="2" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" /></Grid></Grid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <WrapPanel><Button Content="Apply Save As" Click="Apply_Click" Margin="0,0,6,0" /><Button AutomationProperties.AutomationId="StopCliButton" x:Name="StopCliButton" Content="Stop" Click="StopCli_Click" IsEnabled="False" Margin="0,0,6,0" ToolTip="Stop the current operation; the input remains unchanged" /><TextBlock AutomationProperties.AutomationId="ImageStatusText" x:Name="StatusText" Text="Ready" VerticalAlignment="Center" TextWrapping="Wrap" /></WrapPanel>
            <TextBox AutomationProperties.AutomationId="VerificationSummaryText" AutomationProperties.Name="Verification summary" x:Name="VerificationSummaryText" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
