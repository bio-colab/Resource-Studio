<Window x:Class="ResourceStudio.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About Resource Studio"
        Icon="Assets/resource-studio.ico"
        Background="{DynamicResource DeepSlateBrush}"
        Foreground="{DynamicResource PaperBrush}"
        Width="700"
        Height="560"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SlatePanelBrush}"
                BorderBrush="{DynamicResource SignalCyanBrush}"
                BorderThickness="0,0,0,2"
                Padding="0,0,0,14"
                Margin="0,0,0,16">
            <DockPanel>
                <Image Source="Assets/resource-studio-icon-64.png" Width="56" Height="56" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock AutomationProperties.AutomationId="AboutTitleText" Text="Resource Studio" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="PE Resource Workbench" FontSize="13" Foreground="{DynamicResource MistBrush}" />
                    <TextBlock Text="About this build" FontSize="11" Foreground="{DynamicResource SignalCyanBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource SlatePanelBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="About the project" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SignalCyanBrush}" />
                        <TextBlock AutomationProperties.AutomationId="AboutProjectText"
                                   Text="Resource Studio is a verification-first workbench for inspecting, comparing, previewing, and safely editing PE and Win32 resources. It combines a modern WPF experience with read-only analysis, isolated Save As workflows, resource-aware verification, and evidence-oriented diagnostics."
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   LineHeight="22" />
                        <TextBlock Text="The project is built to make resource work understandable and auditable: inspect first, plan the change, verify the output, and keep the original input untouched."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MistBrush}"
                                   Margin="0,8,0,0"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SlateElevatedBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Project home" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Source code, documentation, tests, and contribution guidelines are maintained in the project repository."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MistBrush}"
                                   Margin="0,8,0,8" />
                        <TextBlock AutomationProperties.AutomationId="AboutRepositoryLink" FontSize="13">
                            <Run Text="Repository: " Foreground="{DynamicResource MistBrush}" />
                            <Hyperlink NavigateUri="https://github.com/bio-colab/Resource-Studio" RequestNavigate="RepositoryHyperlink_RequestNavigate">
                                <Run Text="github.com/bio-colab/Resource-Studio" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SlatePanelBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Developed by" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SignalCyanBrush}" />
                        <TextBlock AutomationProperties.AutomationId="AboutDeveloperText" Text="Elias Sharar" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock AutomationProperties.AutomationId="AboutEmailLink" AutomationProperties.Name="aliasbio95@gmail.com" FontSize="13" Margin="0,4,0,0">
                            <Run Text="Contact: " Foreground="{DynamicResource MistBrush}" />
                            <Hyperlink NavigateUri="mailto:aliasbio95@gmail.com" RequestNavigate="RepositoryHyperlink_RequestNavigate">
                                <Run Text="aliasbio95@gmail.com" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Text="Resource Studio is developed as an independent project with a focus on careful resource handling, reproducible verification, and a useful experience for developers and enthusiasts."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MistBrush}"
                                   Margin="0,10,0,0"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Save As only • Original inputs remain untouched"
                       Foreground="{DynamicResource MistBrush}"
                       VerticalAlignment="Center" />
            <Button AutomationProperties.AutomationId="AboutCloseButton"
                    Content="Close"
                    Width="92"
                    HorizontalAlignment="Right"
                    Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
