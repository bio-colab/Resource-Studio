<Window x:Class="ResourceStudio.Windows.ResourceWizardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resource Wizards" Height="760" Width="1000" MinHeight="560" MinWidth="760">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="VersionInfo">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="PE" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="VersionPeBox" Width="390" Margin="0,0,8,0" />
                        <TextBlock Text="ID" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="VersionNameBox" Width="55" Text="1" Margin="0,0,8,0" />
                        <TextBlock Text="Lang" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="VersionLanguageBox" Width="70" Text="1033" />
                    </WrapPanel>
                    <TextBox x:Name="VersionJsonBox" Grid.Row="1" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Load from PE" Click="VersionExport_Click" Margin="0,0,6,0" /><Button Content="Apply Save As" Click="VersionApply_Click" /></WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Manifest">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8"><TextBlock Text="PE" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="ManifestPeBox" Width="500" Margin="0,0,8,0" /><TextBlock Text="Lang" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="ManifestLanguageBox" Width="70" Text="1033" /></WrapPanel>
                    <TextBox x:Name="ManifestXmlBox" Grid.Row="1" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Load from PE" Click="ManifestExport_Click" Margin="0,0,6,0" /><Button Content="Apply Save As" Click="ManifestApply_Click" /></WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Menu">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8"><TextBlock Text="PE" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="MenuPeBox" Width="390" Margin="0,0,8,0" /><TextBlock Text="ID" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="MenuNameBox" Width="55" Text="1" Margin="0,0,8,0" /><TextBlock Text="Lang" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="MenuLanguageBox" Width="70" Text="1033" /></WrapPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><TextBox x:Name="MenuJsonBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="MenuJsonBox_TextChanged" /><TreeView x:Name="MenuTree" Grid.Column="1" Margin="8,0,0,0" AllowDrop="True" PreviewMouseMove="MenuTree_PreviewMouseMove" Drop="MenuTree_Drop" /></Grid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Load from PE" Click="MenuExport_Click" Margin="0,0,6,0" /><Button Content="Apply Save As" Click="MenuApply_Click" /></WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,-22">
            <WrapPanel><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Margin="0,0,8,0" /><Button AutomationProperties.AutomationId="StopCliButton" x:Name="StopCliButton" Content="Stop" Click="StopCli_Click" IsEnabled="False" ToolTip="Stop the current operation; the input remains unchanged" /></WrapPanel>
            <TextBox AutomationProperties.AutomationId="VerificationSummaryText" AutomationProperties.Name="Verification summary" x:Name="VerificationSummaryText" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
