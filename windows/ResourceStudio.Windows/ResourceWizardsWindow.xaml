<Window x:Class="ResourceStudio.Windows.ResourceWizardsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resource Wizards" Height="760" Width="1000" MinHeight="560" MinWidth="760">
    <Grid Margin="12">
        <TabControl>
            <TabItem Header="VersionInfo">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="PE" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="VersionPeBox" Width="390" Margin="0,0,8,0" />
                        <TextBlock Text="ID" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="VersionNameBox" Width="55" Text="1" Margin="0,0,8,0" />
                        <TextBlock Text="Lang" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="VersionLanguageBox" Width="70" Text="1033" />
                    </WrapPanel>
                    <TextBox x:Name="VersionJsonBox" Grid.Row="1" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Load from PE" Click="VersionExport_Click" Margin="0,0,6,0" /><Button Content="Apply Save As" Click="VersionApply_Click" /></WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Manifest">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8"><TextBlock Text="PE" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="ManifestPeBox" Width="500" Margin="0,0,8,0" /><TextBlock Text="Lang" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="ManifestLanguageBox" Width="70" Text="1033" /></WrapPanel>
                    <TextBox x:Name="ManifestXmlBox" Grid.Row="1" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Load from PE" Click="ManifestExport_Click" Margin="0,0,6,0" /><Button Content="Apply Save As" Click="ManifestApply_Click" /></WrapPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Menu">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8"><TextBlock Text="PE" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="MenuPeBox" Width="360" Margin="0,0,8,0" /><TextBlock Text="ID" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="MenuNameBox" Width="55" Text="1" Margin="0,0,8,0" /><TextBlock Text="Lang" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="MenuLanguageBox" Width="70" Text="1033" /></WrapPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <TreeView x:Name="MenuTree" Margin="0,0,8,0" AllowDrop="True" SelectedItemChanged="MenuTree_SelectedItemChanged" PreviewMouseMove="MenuTree_PreviewMouseMove" Drop="MenuTree_Drop" />
                        <TextBox x:Name="MenuJsonBox" Grid.Column="1" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="MenuJsonBox_TextChanged" />
                        <ScrollViewer Grid.Column="2" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="Selected item" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="ID" /><TextBox x:Name="MenuItemIdBox" Margin="0,2" LostFocus="MenuItemProperty_LostFocus" />
                            <TextBlock Text="Text" /><TextBox x:Name="MenuItemTextBox" Margin="0,2" LostFocus="MenuItemProperty_LostFocus" />
                            <TextBlock Text="Flags (hex)" /><TextBox x:Name="MenuItemFlagsBox" Margin="0,2" LostFocus="MenuItemProperty_LostFocus" ToolTip="MF_CHECKED, MF_DISABLED, MF_SEPARATOR and other Win32 flags" />
                            <TextBlock x:Name="MenuItemKindText" Text="No item selected" Margin="0,4,0,8" Foreground="Gray" />
                            <WrapPanel><Button Content="Add root" Click="MenuAddRoot_Click" Margin="0,0,4,4" /><Button Content="Add child" Click="MenuAddChild_Click" Margin="0,0,4,4" /><Button Content="Add separator" Click="MenuAddSeparator_Click" Margin="0,0,4,4" /><Button Content="Delete" Click="MenuDelete_Click" Margin="0,0,4,4" /></WrapPanel>
                            <WrapPanel><Button Content="Move up" Click="MenuMoveUp_Click" Margin="0,0,4,4" /><Button Content="Move down" Click="MenuMoveDown_Click" Margin="0,0,4,4" /><Button Content="Validate" Click="MenuValidate_Click" /></WrapPanel>
                        </StackPanel></ScrollViewer>
                    </Grid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Load from PE" Click="MenuExport_Click" Margin="0,0,6,0" /><Button Content="Apply Save As" Click="MenuApply_Click" /></WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,-22">
            <WrapPanel><TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Margin="0,0,8,0" /><Button AutomationProperties.AutomationId="StopCliButton" x:Name="StopCliButton" Content="Stop" Click="StopCli_Click" IsEnabled="False" ToolTip="Stop the current operation; the input remains unchanged" /></WrapPanel>
            <TextBox AutomationProperties.AutomationId="VerificationSummaryText" AutomationProperties.Name="Verification summary" x:Name="VerificationSummaryText" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
