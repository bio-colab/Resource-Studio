<Window x:Class="ResourceStudio.Windows.DialogEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dialog Editor — WYSIWYG" Height="720" Width="1120" MinHeight="560" MinWidth="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0">
            <Button Content="Load from PE" Click="LoadFromPe_Click" />
            <Button Content="Load JSON" Click="LoadJson_Click" />
            <Button Content="Add Button" Click="AddButton_Click" />
            <Button Content="Add Label" Click="AddLabel_Click" />
            <Button Content="Save As PE" Click="SaveAsPe_Click" />
            <Button Content="Save JSON" Click="SaveJson_Click" />
            <Button AutomationProperties.AutomationId="StopCliButton" x:Name="StopCliButton" Content="Stop" Click="StopCli_Click" IsEnabled="False" ToolTip="Stop the current operation; the input remains unchanged" />
        </WrapPanel>
        <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#777" BorderThickness="1" Background="#F5F5F5" Padding="12">
                <Canvas x:Name="DesignCanvas" Width="520" Height="430" Background="White" MouseLeftButtonDown="Canvas_MouseLeftButtonDown" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseLeftButtonUp" />
            </Border>
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Dialog properties" FontWeight="Bold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Title" Grid.Row="0" Grid.Column="0" Margin="0,4" />
                        <TextBox x:Name="DialogTitleBox" Grid.Row="0" Grid.Column="1" Margin="0,2" LostFocus="DialogProperty_LostFocus" />
                        <TextBlock Text="Width" Grid.Row="1" Grid.Column="0" Margin="0,4" />
                        <TextBox x:Name="DialogWidthBox" Grid.Row="1" Grid.Column="1" Margin="0,2" LostFocus="DialogProperty_LostFocus" />
                        <TextBlock Text="Height" Grid.Row="2" Grid.Column="0" Margin="0,4" />
                        <TextBox x:Name="DialogHeightBox" Grid.Row="2" Grid.Column="1" Margin="0,2" LostFocus="DialogProperty_LostFocus" />
                    </Grid>
                    <Separator Margin="0,10" />
                    <TextBlock Text="PE target" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="PePathBox" Margin="0,2" ToolTip="PE input path" />
                    <DockPanel Margin="0,2">
                        <TextBlock Text="Name" Width="55" VerticalAlignment="Center" />
                        <TextBox x:Name="ResourceNameBox" />
                        <TextBlock Text="Language" Width="70" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBox x:Name="LanguageBox" Width="70" />
                    </DockPanel>
                    <Separator Margin="0,10" />
                    <TextBlock Text="Selected control" FontWeight="Bold" Margin="0,0,0,6" />
                    <ListBox x:Name="ControlsList" Height="120" SelectionChanged="ControlsList_SelectionChanged" DisplayMemberPath="Display" />
                    <WrapPanel Margin="0,6,0,0"><Button Content="Add Edit" Click="AddEdit_Click" Margin="0,0,4,4" /><Button Content="Add List" Click="AddList_Click" Margin="0,0,4,4" /><Button Content="Add Combo" Click="AddCombo_Click" Margin="0,0,4,4" /><Button Content="Delete" Click="DeleteControl_Click" Margin="0,0,4,4" /><Button Content="Duplicate" Click="DuplicateControl_Click" /></WrapPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="ID / Help ID" Grid.Row="0" Grid.Column="0" Margin="0,4" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="ControlIdBox" Width="65" Margin="0,2" LostFocus="ControlProperty_LostFocus" /><TextBox x:Name="ControlHelpIdBox" Width="75" Margin="8,2,0,2" LostFocus="ControlProperty_LostFocus" /></StackPanel>
                        <TextBlock Text="Class" Grid.Row="1" Grid.Column="0" Margin="0,4" />
                        <TextBox x:Name="ControlClassBox" Grid.Row="1" Grid.Column="1" Margin="0,2" LostFocus="ControlProperty_LostFocus" ToolTip="Ordinal 0x0080..0x0085 or custom class name" />
                        <TextBlock Text="Text" Grid.Row="2" Grid.Column="0" Margin="0,4" />
                        <TextBox x:Name="ControlTextBox" Grid.Row="2" Grid.Column="1" Margin="0,2" LostFocus="ControlProperty_LostFocus" />
                        <TextBlock Text="X / Y" Grid.Row="3" Grid.Column="0" Margin="0,4" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="ControlXBox" Width="65" Margin="0,2" LostFocus="ControlProperty_LostFocus" /><TextBox x:Name="ControlYBox" Width="65" Margin="8,2,0,2" LostFocus="ControlProperty_LostFocus" /></StackPanel>
                        <TextBlock Text="Width / Height" Grid.Row="4" Grid.Column="0" Margin="0,4" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="ControlWidthBox" Width="65" Margin="0,2" LostFocus="ControlProperty_LostFocus" /><TextBox x:Name="ControlHeightBox" Width="65" Margin="8,2,0,2" LostFocus="ControlProperty_LostFocus" /></StackPanel>
                        <TextBlock Text="Style" Grid.Row="5" Grid.Column="0" Margin="0,4" />
                        <TextBox x:Name="ControlStyleBox" Grid.Row="5" Grid.Column="1" Margin="0,2" LostFocus="ControlProperty_LostFocus" />
                        <TextBlock Text="Exstyle" Grid.Row="6" Grid.Column="0" Margin="0,4" />
                        <TextBox x:Name="ControlExstyleBox" Grid.Row="6" Grid.Column="1" Margin="0,2" LostFocus="ControlProperty_LostFocus" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" Text="Ready" />
            <TextBox AutomationProperties.AutomationId="VerificationSummaryText" AutomationProperties.Name="Verification summary" x:Name="VerificationSummaryText" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
