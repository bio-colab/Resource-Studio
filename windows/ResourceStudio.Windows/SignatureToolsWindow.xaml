<Window x:Class="ResourceStudio.Windows.SignatureToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Authenticode Tools" Height="560" Width="760" MinHeight="420" MinWidth="620">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Authenticode test workflow" FontSize="18" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap" Text="All operations use Save As. The original PE is never overwritten. Test signatures are not trusted by Windows until the certificate is explicitly installed in the isolated test environment." />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Inspect" Click="Inspect_Click" Margin="0,0,6,0" />
            <Button Content="Strip signature" Click="Strip_Click" Margin="0,0,6,0" />
            <Button Content="Create test certificate" Click="CreateCertificate_Click" />
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="PFX certificate" VerticalAlignment="Center" />
            <TextBox x:Name="CertificatePathBox" Grid.Column="1" IsReadOnly="True" Padding="5" />
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="PFX password" VerticalAlignment="Center" />
            <PasswordBox x:Name="PasswordBox" Grid.Column="1" Padding="5" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                <CheckBox x:Name="ReplaceExistingBox" Content="Replace existing signature" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Re-sign to new PE" Click="Resign_Click" />
                <Button AutomationProperties.AutomationId="StopCliButton" x:Name="StopCliButton" Content="Stop" Click="StopCli_Click" IsEnabled="False" Margin="8,0,0,0" ToolTip="Stop the current operation; the input remains unchanged" />
            </StackPanel>
        </Grid>
        <TextBox AutomationProperties.AutomationId="SignatureOutputBox" AutomationProperties.Name="Signature operation details" x:Name="OutputBox" Grid.Row="5" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="6" Margin="0,6,0,0">
            <TextBlock x:Name="StatusText" Text="Ready" />
            <TextBox AutomationProperties.AutomationId="VerificationSummaryText" AutomationProperties.Name="Verification summary" x:Name="VerificationSummaryText" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
