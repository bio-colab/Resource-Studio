<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ResourceStudio.Windows</AssemblyName>
    <RootNamespace>ResourceStudio.Windows</RootNamespace>
    <ApplicationIcon>Assets\resource-studio.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\resource-studio.ico" />
    <Resource Include="Assets\resource-studio-icon-16.png" />
    <Resource Include="Assets\resource-studio-icon-32.png" />
    <Resource Include="Assets\resource-studio-icon-64.png" />
  </ItemGroup>
</Project>
